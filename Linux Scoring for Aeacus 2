name = "skyview-warriors-mint21"
title = "Skyview Warriors Security Audit"
os = "Linux Mint 21"
user = "coolUser"
version = "2.1.1"

# =============================================================
# FORENSIC QUESTIONS (5 Points Each = 10 Points Total)
# =============================================================
[[forensics]]
question = "Forensic Question 1"
answer = "amltYm9i"
points = 5
message = "Correctly solved Forensic Question 1!"

[[forensics]]
question = "Forensic Question 2"
answer = "16"
points = 5
message = "Correctly solved Forensic Question 2!"

# =============================================================
# SYSTEM UTILITIES & PERIMETER SECURITY (5 Points Each = 15 Points)
# =============================================================
[[check]]
message = "Secured the network perimeter by enabling the UFW firewall."
points = 5
  [[check.pass]]
  type = "FirewallUp"

[[check]]
message = "Disabled or removed unauthorized web server infrastructure (Nginx)."
points = 5
  [[check.pass]]
  type = "PackageNotInstalled"
  target = "nginx"

[[check]]
message = "Enabled IPv4 TCP SYN cookies to prevent flooding attacks."
points = 5
  [[check.pass]]
  type = "FileContains"
  path = "/etc/sysctl.conf"
  value = "net.ipv4.tcp_syncookies=1"

# =============================================================
# SYSTEM UPDATES & CORE PACKAGES (5 Points Each = 10 Points)
# =============================================================
[[check]]
message = "Configured Update Manager to install security updates automatically."
points = 5
  [[check.pass]]
  type = "FileContains"
  path = "/etc/apt/apt.conf.d/20auto-upgrades"
  value = "APT::Periodic::Update-Package-Lists \"1\";"

[[check]]
message = "Firefox remains installed and updated as the native enterprise browser."
points = 5
  [[check.pass]]
  type = "PackageInstalled"
  target = "firefox"

# =============================================================
# PAM PASSWORD SECURITY POLICIES (5 Points Each = 20 Points)
# =============================================================
[[check]]
message = "Account lockout policy (faillock) configured for brute force defense."
points = 5
  [[check.pass]]
  type = "FileContains"
  path = "/etc/pam.d/common-auth"
  value = "pam_faillock.so"

[[check]]
message = "Enforced a strict minimum password length constraint of 10 characters."
points = 5
  [[check.pass]]
  type = "FileContains"
  path = "/etc/security/pwquality.conf"
  value = "minlen = 10"

[[check]]
message = "Configured the system to remember the history of the previous 3 passwords."
points = 5
  [[check.pass]]
  type = "FileContains"
  path = "/etc/pam.d/common-password"
  value = "remember=3"

[[check]]
message = "Prevented null passwords from authenticating onto system accounts."
points = 5
  [[check.pass]]
  type = "FileContainsNot"
  path = "/etc/pam.d/common-auth"
  value = "nullok"

# =============================================================
# SSH HARDENING (5 Points Each = 5 Points)
# =============================================================
[[check]]
message = "Disabled direct administrative root logins over remote SSH shells."
points = 5
  [[check.pass]]
  type = "FileContains"
  path = "/etc/ssh/sshd_config"
  value = "PermitRootLogin no"

# =============================================================
# PROHIBITED MEDIA POLICIES (5 Points Each = 5 Points)
# =============================================================
[[check]]
message = "Prohibited audio tracks (.mp3) scrubbed from the system environment."
points = 5
  [[check.pass]]
  type = "PathExistsNot"
  path = "/home/coolUser/Music/badtrack.mp3"

# =============================================================
# USER MANAGEMENT & ACCOUNT PRIVILEGES (5 Points Each = 35 Points)
# =============================================================

[[check]]
message = "Secured rgupta's account by changing their password to a strong phrase."
points = 5
  [[check.pass]]
  type = "FileContainsNot"
  path = "/etc/shadow"
  value = "rgupta:$6$OLD_INSECURE_HASH_HERE" # Put rgupta's original hash snippet here

[[check]]
message = "vsharma upgraded to an authorized administrator."
points = 5
  [[check.pass]]
  type = "UserInGroup"
  user = "vsharma"
  group = "sudo"

[[check]]
message = "Demoted vpradhan from administrators to a standard default user."
points = 5
  [[check.pass]]
  type = "UserInGroupNot"
  user = "vpradhan"
  group = "sudo"

[[check]]
message = "Demoted hkancheti from administrators to a standard default user."
points = 5
  [[check.pass]]
  type = "UserInGroupNot"
  user = "hkancheti"
  group = "sudo"

[[check]]
message = "Successfully removed unauthorized system user psundt."
points = 5
  [[check.pass]]
  type = "UserExistsNot"
  user = "psundt"

[[check]]
message = "Successfully uncovered and removed hidden backdoor account lhardwick."
points = 5
  [[check.pass]]
  type = "UserExistsNot"
  user = "lhardwick"
